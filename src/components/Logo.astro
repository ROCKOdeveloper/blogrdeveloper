---
import Face from '../assets/face.svg';
import { SITE } from '../consts';

interface Props {
  size?: 'large' | 'small';
}

const { size = 'large' } = Astro.props;
---

<a class:list={['logo', 'press', `logo--${size}`]} href="/" aria-label={`${SITE.name}, inicio`}>
  <Face class="logo__face" aria-hidden="true" />
  <span class="logo__name">{SITE.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    text-decoration: none;
  }

  .logo--large {
    font-size: var(--text-lg);
  }

  .logo--small {
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  .logo__face {
    width: 1.9em;
    height: 1.9em;
    color: var(--color-accent);
    transition: transform var(--duration-hover) var(--ease-out);
  }

  /* Un leve giro, como quien inclina la cabeza al saludar. */
  @media (hover: hover) and (pointer: fine) {
    .logo:hover .logo__face {
      transform: rotate(-10deg) scale(1.08);
    }
  }
</style>
